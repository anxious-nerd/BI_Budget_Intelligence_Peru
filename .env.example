# Copia este archivo a `.env` y ajusta. Todas las variables son opcionales (hay valores por defecto).

# ---- Origen: tus datos crudos del MEF --------------------------------------------------
# Opción A: parquet (glob o carpeta)
MEF_RAW_GASTO=data/raw/gasto/*.parquet
MEF_RAW_INGRESO=data/raw/ingreso/*.parquet
# Opción B: tablas dentro de un .duckdb que ya tienes (se adjunta en solo lectura)
#MEF_ATTACH=raw=C:/ruta/a/tu_base.duckdb
#MEF_RAW_GASTO=raw.gasto
#MEF_RAW_INGRESO=raw.ingreso
# Archivos cuyo nombre cumpla esta regex se IGNORAN (los *-Diario duplicarían los *-Mensual)
MEF_EXCLUDE_FILES_REGEX=(?i)diario

# ---- Semántica de los montos por mes (decídelo con `python -m etl.profile`) ----------------
#   cumulative = certificado/comprometido/devengado/girado/recaudado vienen ACUMULADOS al mes
#   flow       = vienen como flujo del mes
MEF_EXEC_MODE=flow       # medido con etl.profile sobre los parquet del Drive (2023-2026): vienen como flujo

# ---- Cómo vienen PIA y PIM (saldos presupuestales). Confírmalo con `python -m etl.profile` --------
#   snapshot = saldo repetido cada mes, o solo en el mes 0 de apertura  -> vigente = último mes <= corte
#   sum      = registrado una vez (PIA) o como modificaciones del periodo (PIM) -> vigente = suma <= corte
MEF_BUDGET_MODE_GASTO=snapshot
MEF_BUDGET_MODE_INGRESO=sum

# ---- Tabla de ubigeos (latitud/longitud para los mapas) ----------------------------------------
# CSV de datos abiertos (separador ';', coma decimal). Viene incluida en data/ref/.
MEF_UBIGEO_TABLE=data/ref/TB_UBIGEOS.csv
# Con qué columna de esa tabla se cruza el ubigeo del MEF. inei y reniec NO coinciden en la mayoría
# de distritos: `python -m etl.profile` mide cuál calza con tus datos (sección [3b]).
MEF_UBIGEO_CODE=inei

# ---- Destino y recursos -----------------------------------------------------------------
MEF_WAREHOUSE=warehouse
MEF_MEMORY_LIMIT=4GB
MEF_THREADS=0            # 0 = todos los núcleos
#MEF_TEMP_DIR=warehouse/.duckdb_tmp

# ---- Dashboard ------------------------------------------------------------------------------
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=0

# ---- SQL Server (docker-compose.yml y etl/load_mssql.py) ---------------------------------------
# Contraseñas: 8+ caracteres con mayúsculas, minúsculas, números y símbolos. Sin comillas simples (').
MSSQL_SA_PASSWORD=Cambia-Esto-SA-2026
MSSQL_DB=MEF_DW
# Usuario ADMIN: carga, transforma y borra (db_owner solo de MEF_DW)
MSSQL_ADMIN_USER=mef_admin
MSSQL_ADMIN_PASSWORD=Cambia-Esto-Admin-2026
# Usuario de SOLO CONSULTA (el que se reparte al equipo)
MSSQL_READER_USER=mef_lector
MSSQL_READER_PASSWORD=Cambia-Esto-Lector-2026
# Dónde se conecta el cargador cuando corre FUERA de Docker (dentro del compose se usa "mssql")
MSSQL_HOST=localhost
MSSQL_PORT=1433
# En qué interfaz publica el puerto: 127.0.0.1 = solo esta máquina; 0.0.0.0 = red (VM, con firewall)
MSSQL_BIND=127.0.0.1
MSSQL_MEMORY_LIMIT_MB=4096
# Tu uid/gid (`id -u`, `id -g`) para que lo que escribe el contenedor del ETL quede a tu nombre
MEF_UID=1000
MEF_GID=1000
